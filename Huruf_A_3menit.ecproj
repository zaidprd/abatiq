                      "expr": {
                        "text": "function sm(x){x=Math.min(1,Math.max(0,x));return x*x*(3-2*x);}var wk=(time>0.5&&time<2.3)?sm((time-0.5)/0.2)*sm((2.3-time)/0.2):0;var p=(time-0.5)*2*Math.PI*1.7;var WV=[[5,6.9],[15.5,16.9],[19,20.4],[41.5,42.9],[53.5,54.9],[65.5,66.9],[76.5,77.9],[139,140.4],[152,153.4],[170,171.9]];var PT=[[139.6,146],[152.6,161]];var wv=0;WV.forEach(function(w){wv=Math.max(wv,sm((time-w[0])/0.45)*sm((w[1]-time)/0.5));});var pt=0;PT.forEach(function(w){pt=Math.max(pt,sm((time-w[0])/0.5)*sm((w[1]-time)/0.5));});var idle=Math.sin(time*1.7);var r=-118*wv-62*pt+8*wk*Math.sin(p)+1.5*idle;r;",
