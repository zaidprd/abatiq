                      "value": {
                        "t": "Scalar",
                        "v": 0.0
                      },
                      "expr": {
                        "text": "function roll(tl,Am){var d=time-tl;return (d>0&&d<1.0)?Am*Math.exp(-d*4.5)*Math.sin(d*8):0;}function nudge(tl,Am){var d=time-tl;return (d>0&&d<0.5)?Am*Math.exp(-d*7)*Math.sin(d*15):0;}roll(75.3,8);",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Angle"
                      },
                      "spatial": false,
                      "hold_only": false,
                      "three_d_only": false,
