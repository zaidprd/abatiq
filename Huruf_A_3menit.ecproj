                      "expr": {
                        "text": "var t=Math.min(1,Math.max(0,(time-3.0)/1.0));var e=t*t*(3-2*t);var hop=Math.sin(t*Math.PI)*160;var nod=(time>4)?Math.sin((time-4)*4.5)*Math.min(1,(time-4)/0.4):0;\n[1900+(560-1900)*e,890-hop];",
                        "enabled": true
