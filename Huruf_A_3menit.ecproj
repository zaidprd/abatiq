                          0.0
                        ]
                      },
                      "expr": {
                        "text": "var g=Math.min(1,Math.max(0,(time-62)/1.3));var e=g*g*(3-2*g);var ey=Math.pow(g,1.6);var hp=Math.sin(g*Math.PI)*120;function hop(tl,Am){var d=time-tl,y=0;if(d>0&&d<0.4){var u=d/0.4;y=Am*4*u*(1-u);}else if(d>=0.4&&d<0.62){var u=(d-0.4)/0.22;y=Am*0.25*4*u*(1-u);}return y;}function nudge(tl,Am){var d=time-tl;return (d>0&&d<0.5)?Am*Math.exp(-d*7)*Math.sin(d*17):0;}[1180+(1704-1180)*e,470+(722-470)*ey-hp-hop(63.3,11)-(0+nudge(75.3,4))];",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Point"
                      },
                      "spatial": true,
                      "hold_only": false,
                      "three_d_only": false,
                      "two_d_only": false,
                      "shown_dims": 2,
                      "static_only": false
                    },
                    {
