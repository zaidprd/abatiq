                      "match": "scale",
                      "name": "Scale",
                      "value": {
                        "t": "Vec3",
                        "v": [
                          100.0,
                          100.0,
                          100.0
                        ]
                      },
                      "expr": {
                        "text": "var t=Math.min(1,Math.max(0,(time-53)/0.4));var s=t<0.6?(t/0.6)*115:115-(t-0.6)/0.4*15;s=s*60/100;var g=Math.min(1,Math.max(0,(time-62)/1.3));var e=g*g*(3-2*g);s=s*(1-0.50*e);var ed=Math.min(1,Math.max(0,(time-75.6)/0.5));s=s*(1-ed);[s,s];",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Percent"
                      },
                      "spatial": false,
