                      "expr": {
                        "text": "var t=Math.min(1,Math.max(0,(time-151.3)/0.4));var s=t<0.6?(t/0.6)*115:115-(t-0.6)/0.4*15;s=s*100/100;var ed=Math.min(1,Math.max(0,(time-164.5)/0.4));s=s*(1-ed);var z=Math.min(1,Math.max(0,(time-161)/0.7));z=z*z*(3-2*z);s=s*(1+1.6*z);[s,s];",
                        "enabled": true
                      },
