                        "text": "var t=Math.min(1,Math.max(0,(time-65)/0.4));var s=t<0.6?(t/0.6)*115:115-(t-0.6)/0.4*15;s=s*60/100;var g=Math.min(1,Math.max(0,(time-74)/1.3));var e=g*g*(3-2*g);s=s*(1-0.5*e);[s,s];",
                        "enabled": true
