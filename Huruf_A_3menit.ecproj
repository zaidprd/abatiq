                          0.0
                        ]
                      },
                      "expr": {
                        "text": "var g=Math.min(1,Math.max(0,(time-74)/1.3));var e=g*g*(3-2*g);var hop=Math.sin(g*Math.PI)*120;[1180+(1660-1180)*e,470+(780-470)*e-hop];",
