                        ]
                      },
                      "expr": {
                        "text": "if(time<0.7999999999999999){[0,0];}else if(time<1.2){var s=linear(time,0.7999999999999999,1.2,0,100);[s,s];}else if(time>=3.6&&time<4){var t=(time-3.6)/0.3999999999999999;var s=Math.sin(t*Math.PI)*15;[100-s,100+s];}else{[100,100];}",
                        "enabled": true
                      },
                      "ui": {
