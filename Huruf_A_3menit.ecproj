                      "expr": {
                        "text": "var m=thisComp.layer('Mobil').transform.position;var T=[660,860];var t=Math.min(1,Math.max(0,(time-6.4)/1.2));var e=t*t*(3-2*t);var hop=Math.sin(t*Math.PI)*70;\n[m[0]+(T[0]-m[0])*e,m[1]+(T[1]-m[1])*e-hop];",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Point"
