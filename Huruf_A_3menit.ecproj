                        "text": "function e(t){return t<0.5?2*t*t:1-2*(1-t)*(1-t);}function c(x){return Math.min(1,Math.max(0,x));}\nvar ph;if(time<1.2)ph=0;else if(time<3.6)ph=e(c((time-1.2)/2.4))*5.5;else if(time<4.0)ph=5.5;else if(time<5.4)ph=5.5+e(c((time-4.0)/1.4))*1.8;else ph=7.3;\nvar mv=linear(time,1.1,1.5,0,1)*linear(time,5.2,5.6,1,0);var s=Math.sin(ph*2*Math.PI);\n[100+1.2*mv*s,100-0.8*mv*s];",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Percent"
                      },
                      "spatial": false,
