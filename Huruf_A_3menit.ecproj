                          540.0,
                          0.0
                        ]
                      },
                      "expr": {
                        "text": "var z=Math.min(1,Math.max(0,(time-161)/0.7));z=z*z*(3-2*z);var bob=(1-z)*10*Math.sin(time*2.2+2);var by=520+(540-520)*z;[ 1430+(960-1430)*z, by+bob];",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Point"
