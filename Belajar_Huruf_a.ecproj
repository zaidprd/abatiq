                    {
                      "node": "Prop",
                      "uid": 1182,
                      "match": "rotation",
                      "name": "Rotation",
                      "value": {
                        "t": "Scalar",
                        "v": 0.0
                      },
                      "expr": {
                        "text": "var B=thisComp.layer('Letter_Reveal').content('Bowl').content('Path 1').path;var S=thisComp.layer('Letter_Reveal').content('Stem').content('Path 1').path;\nfunction e(t){return t<0.5?2*t*t:1-2*(1-t)*(1-t);}\nfunction c(x){return Math.min(1,Math.max(0,x));}\nfunction hd(P,q){var q1=c(q-0.004),q2=c(q+0.004);var a=P.pointOnPath(q1),b=P.pointOnPath(q2);return Math.atan2(b[1]-a[1],b[0]-a[0])*180/Math.PI;}\nif(time<1.2){hd(B,0);}\nelse if(time<3.6){hd(B,e(c((time-1.2)/2.4000000000000004)));}\nelse if(time<4){var t=(time-3.6)/0.3999999999999999;hd(B,1)-135*e(t);}\nelse if(time<5.4){90;}\nelse{90+Math.sin((time-5.4)*14)*6;}",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Angle"
                      },
                      "spatial": false,
                      "hold_only": false,
