                      "match": "opacity",
                      "name": "Opacity",
                      "value": {
                        "t": "Scalar",
                        "v": 100.0
                      },
                      "expr": {
                        "text": "time<7.5?100:0;",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Slider",
                        "min": 0.0,
                        "max": 100.0,
                        "slider_min": 0.0,
                        "slider_max": 100.0,
                        "decimals": 0
                      },
