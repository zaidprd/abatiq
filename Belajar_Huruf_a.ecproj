                {
                  "node": "Group",
                  "uid": 1184,
                  "match": "transform",
                  "name": "Transform",
                  "kind": {
                    "kind": "Plain"
                  },
                  "enabled": true,
                  "children": [
                    {
                      "node": "Prop",
                      "uid": 1176,
                      "match": "anchor",
                      "name": "Anchor Point",
                      "value": {
                        "t": "Vec3",
                        "v": [
                          0.0,
                          0.0,
                          0.0
                        ]
                      },
                      "ui": {
                        "kind": "Point"
                      },
                      "spatial": true,
                      "hold_only": false,
                      "three_d_only": false,
                      "two_d_only": false,
                      "shown_dims": 2,
                      "static_only": false
                    },
                    {
                      "node": "Prop",
                      "uid": 1177,
                      "match": "position",
                      "name": "Position",
                      "value": {
                        "t": "Vec3",
                        "v": [
                          960.0,
                          540.0,
                          0.0
                        ]
                      },
                      "expr": {
                        "text": "var B=thisComp.layer('Letter_Reveal').content('Bowl').content('Path 1').path;var S=thisComp.layer('Letter_Reveal').content('Stem').content('Path 1').path;\nfunction e(t){return t<0.5?2*t*t:1-2*(1-t)*(1-t);}\nfunction c(x){return Math.min(1,Math.max(0,x));}\nif(time<1.2){B.pointOnPath(0);}\nelse if(time<3.6){B.pointOnPath(e(c((time-1.2)/2.4000000000000004)));}\nelse if(time<4){var t=(time-3.6)/0.3999999999999999;var a=B.pointOnPath(1);var b=S.pointOnPath(0);[a[0]+(b[0]-a[0])*e(t), a[1]+(b[1]-a[1])*e(t)-Math.sin(t*Math.PI)*90];}\nelse if(time<5.4){S.pointOnPath(e(c((time-4)/1.4000000000000004)));}\nelse{S.pointOnPath(1);}",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Point"
                      },
                      "spatial": true,
                      "hold_only": false,
                      "three_d_only": false,
                      "two_d_only": false,
                      "shown_dims": 2,
                      "static_only": false
                    },
                    {
                      "node": "Prop",
                      "uid": 1178,
                      "match": "scale",
                      "name": "Scale",
                      "value": {
                        "t": "Vec3",
                        "v": [
                          100.0,
                          100.0,
                          100.0
                        ]
                      },
                      "expr": {
                        "text": "if(time<0.7999999999999999){[0,0];}else if(time<1.2){var s=linear(time,0.7999999999999999,1.2,0,100);[s,s];}else if(time>=3.6&&time<4){var t=(time-3.6)/0.3999999999999999;var s=Math.sin(t*Math.PI)*15;[100-s,100+s];}else{[100,100];}",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Percent"
                      },
                      "spatial": false,
                      "hold_only": false,
                      "three_d_only": false,
                      "two_d_only": false,
                      "shown_dims": 2,
                      "static_only": false
                    },
                    {
                      "node": "Prop",
                      "uid": 1179,
                      "match": "orientation",
                      "name": "Orientation",
                      "value": {
                        "t": "Vec3",
                        "v": [
