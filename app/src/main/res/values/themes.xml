<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Theme is intentionally minimal: we let Compose paint the entire UI
        inside the MainActivity. The system theme just sets the status-bar
        colour so the app does not flash white on cold start.
    -->
    <style name="Theme.AbatiQ" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>